      "@type": "FAQPage",
      "@id": "__SITE_BASE__/blog/ipohondriya-trevoga-za-zdorove-psiholog/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Ипохондрия – это ОКР?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В МКБ-11 – обсессивно-компульсивный спектр. Механизм похож: навязчивая мысль (страх болезни) и ритуал (проверки тела, гугление, визиты к врачам). Это не значит, что вам «поставили ОКР» по статье – диагноз ставит только врач-психиатр. Но понимание механизма снимает стыд: вы не капризничаете, ваша психика застряла в цикле проверок."
          }
        },
        {
          "@type": "Question",
          "name": "Поможет ли EMDR?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если тревога запустилась после травмы – операции, потери близкого – EMDR снимает эмоциональный заряд с воспоминания."
          }
        },
        {
          "@type": "Question",
          "name": "Это психосоматика?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не совсем. При психосоматике тело выдает реальный симптом от стресса. При тревоге за здоровье симптома может не быть – есть страх его найти."
          }
        },
        {
          "@type": "Question",
          "name": "Как перестать гуглить?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Резко сложно. Увеличивайте паузу между импульсом и браузером. «Ипохондрия симптомы» ищут сотни людей ежемесячно – вы не одиноки."
          }
        },
        {
          "@type": "Question",
          "name": "Психолог отменит визиты к врачу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Диспансеризация раз в год – норма. Беготня по пяти онкологам за месяц – мишень для терапии."
          }
        },
        {
          "@type": "Question",
          "name": "Близкие говорят: «Ты привлекаешь внимание»",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Это обесценивание. Вы не выбирали бояться. Семье стоит спросить: «Как поддержать, не подпитывая тревогу?»"
          }
        }
      ]
    }

      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://www.morozovanatalia.ru/blog/emdr-dpdg-prostymi-slovami/"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://www.morozovanatalia.ru/blog/emdr-dpdg-prostymi-slovami/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "EMDR — это гипноз?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Вы остаётесь в сознании, видите и слышите происходящее, можете попросить остановить или замедлить процесс. Это прямо указано в договоре публичной оферты практики."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько длится сессия?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Основная консультация — 90 минут. Пробная встреча для знакомства — 30 минут, бесплатно, в онлайн-формате."
          }
        },
        {
          "@type": "Question",
          "name": "EMDR подходит всем?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Метод обсуждается индивидуально. Есть состояния, при которых сначала нужна медицинская помощь или другой формат поддержки. Гарантий результата психолог не даёт — это нормальная этическая рамка."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли пройти EMDR онлайн?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, многие специалисты проводят сессии по видеосвязи с адаптированной билатеральной стимуляцией. Первая пробная встреча как раз обычно онлайн."
          }
        },
        {
          "@type": "Question",
          "name": "Чем EMDR отличается от обычной беседы с психологом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В разговорной работе акцент на осмыслении и поддержке. В EMDR добавляется структурированная переработка с билатеральной стимуляцией, чтобы снизить эмоциональный заряд конкретного материала, а не только «обсудить его»."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько нужно сессий?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Зависит от запроса и вашего темпа. Иногда заметные сдвиги появляются за несколько встреч, иногда нужен более длительный процесс. Количество планируют вместе со специалистом, без жёстких обещаний «за N сеансов»."
          }
        }
      ]
    }
  ]
}

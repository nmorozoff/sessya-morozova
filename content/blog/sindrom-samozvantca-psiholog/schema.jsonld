    {
      "@type": "FAQPage",
      "@id": "__SITE_BASE__/blog/sindrom-samozvantca-psiholog/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Что такое синдром самозванца в психологии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Это не медицинский диагноз. Это устойчивый психологический паттерн, при котором человек, имея реальные достижения, искренне считает себя некомпетентным и приписывает успехи случайному стечению обстоятельств."
          }
        },
        {
          "@type": "Question",
          "name": "Чем это состояние отличается от перфекционизма?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Перфекционист мучается от того, что результат его работы не идеален. Самозванец же мучается от того, что он вообще некомпетентен, а текущий хороший результат – это просто удачная маскировка."
          }
        },
        {
          "@type": "Question",
          "name": "Как страх разоблачения связан с тревогой?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Они идут рука об руку. Постоянное ожидание того, что вас вот-вот \"раскроют\", держит нервную систему в режиме боевой готовности. Это истощает ресурсы и приводит к хронической тревоге."
          }
        },
        {
          "@type": "Question",
          "name": "Поможет ли мне тест на синдром самозванца?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Тесты помогают оцифровать проблему. Увидев высокий балл, вы можете осознать масштаб проблемы. Но сам тест не даст рабочих инструментов для изменений."
          }
        },
        {
          "@type": "Question",
          "name": "Как понять, когда точно нужен психолог?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если вы регулярно отказываетесь от заслуженного повышения, молчите на важных встречах из страха сказать глупость, или не можете спать из-за навязчивых мыслей о грядущем провале – пора обращаться к специалисту."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли справиться самостоятельно?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "На начальных этапах отлично работает дневник фактов. Но если этот паттерн намертво закрепился с детства, самостоятельные попытки часто превращаются в изматывающую борьбу с ветряными мельницами. Нужен бережный взгляд со стороны."
          }
        },
        {
          "@type": "Question",
          "name": "Как проходит первая встреча?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Мы просто знакомимся. Вы рассказываете, что именно вас беспокоит, в комфортном для вас темпе. Мы не идем в глубокую травму на первой встрече, мы просто намечаем безопасный маршрут работы."
          }
        }
      ]
    }

      "mainEntity": [
        {
          "@type": "Question",
          "name": "Опасна ли паническая атака для жизни?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сама паника часто пугает сильнее, чем наносит физический вред, но при первых эпизодах важно исключить медицинские причины у врача. При боли в груди, обмороке — экстренная помощь."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли «вылечить» панику самому?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Техники заземления помогают в моменте. Устойчивые изменения чаще требуют работы со специалистом. Психолог не обещает гарантированный результат."
          }
        },
        {
          "@type": "Question",
          "name": "Чем паника отличается от инфаркта?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Только врач может надёжно различить состояния. Не откладывайте обращение за медицинской помощью, если сомневаетесь."
          }
        },
        {
          "@type": "Question",
          "name": "Связана ли паника с травмой?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Иногда да — тело реагирует на накопленный стресс или пережитый опыт. Это обсуждается индивидуально на консультации."
          }
        },
        {
          "@type": "Question",
          "name": "Помогает ли EMDR?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Метод может быть уместен при определённых запросах. Подходит ли он вам — вопрос для пробной встречи с психологом."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько длится сессия с психологом?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "90 минут основная консультация; 30 минут — бесплатная пробная онлайн."
          }
        },
        {
          "@type": "Question",
          "name": "Куда звонить в кризисе?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "112, скорая помощь — при угрозе жизни. Плановая сессия не заменяет экстренную помощь."
          }
        }
      ]

      "mainEntity": [
        {
          "@type": "Question",
          "name": "Горю ли я по родителю, если он жив?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Вы можете скорбеть по тёплому родителю, которого не было, по разговору, который так и не состоялся. Это горе по несбывшейся привязанности. Оно не требует смерти: достаточно холодности, отсутствия интереса, боли в детстве, которую вы до сих пор несёте."
          }
        },
        {
          "@type": "Question",
          "name": "Нормально ли злиться на маму или папу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Злость — частый спутник такого горя. Её часто стыдятся: «они же старались». В безопасной работе злость можно выразить без разрушения себя и без обязательного примирения. Когда заряд снижается, иногда появляется и печаль, и сочувствие к себе-ребёнку."
          }
        },
        {
          "@type": "Question",
          "name": "Обязан ли я поддерживать контакт?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет универсального долга. Решение зависит от вашей безопасности, готовности и границ. Терапия не заставляет «простить и звонить», а помогает понять, что вы выбираете из свободы, а не из вины или страха."
          }
        }
      ]
    }

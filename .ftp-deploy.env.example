# Скопируйте этот файл в .ftp-deploy.env и заполните значения.
# Файл .ftp-deploy.env в git не попадает — пароли остаются только на вашем компьютере.
#
# Как получить данные в Timeweb:
# Панель → Хостинг → FTP-доступ (или Файловый менеджер → данные FTP)
#
# После заполнения напишите в чат: «FTP готово» — ассистент запустит деплой.

# Публичный URL сайта (для sitemap и meta-тегов при сборке)
VITE_SITE_URL=https://www.morozovanatalia.ru

# Хост FTP (например vh123.timeweb.ru или IP)
FTP_SERVER=

# Логин FTP
FTP_USERNAME=

# Пароль FTP
FTP_PASSWORD=

# Папка сайта на сервере (обычно /public_html/ или /domains/morozovanatalia.ru/public_html/)
FTP_SERVER_DIR=/public_html/

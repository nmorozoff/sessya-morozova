    {
      "@type": "FAQPage",
      "@id": "__SITE_BASE__/blog/trevoga-pered-snom-psiholog/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Почему перед сном начинается тревога, хотя день прошел спокойно?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Потому что исчезает внешний шум. Мозг, привыкший к стимуляции, начинает сканировать внутреннее пространство. Подавленные эмоции или нерешенные фоновые задачи выходят на первый план именно в тишине."
          }
        },
        {
          "@type": "Question",
          "name": "Тревога мешает уснуть - что делать прямо сейчас?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не пытайтесь заставить себя спать. Встаньте с кровати. Запишите мысли на лист бумаги. Сделайте несколько циклов дыхания 4-7-8. Вернитесь в постель только при четком ощущении сонливости."
          }
        },
        {
          "@type": "Question",
          "name": "Мне нужен психолог или сомнолог?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если проблема связана с храпом, апноэ или сбоями дыхания - сомнолог. Если вы не можете уснуть из-за крутящихся мыслей, страха завтрашнего дня и напряжения в теле - начните с психолога."
          }
        },
        {
          "@type": "Question",
          "name": "Отличается ли это от общей тревожности?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Часто ночная тревога - это просто отложенная дневная. Вытесненные днем переживания догоняют вас ночью. Но иногда это специфический страх именно перед процессом сна (вторичная тревога)."
          }
        },
        {
          "@type": "Question",
          "name": "Помогают ли травяные чаи и теплое молоко?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Они работают как часть успокаивающего ритуала, формируя привычку. Но физиологически они не способны остановить выброс кортизола, если вы активно руминируете о завтрашнем отчете."
          }
        }
      ]
    }

      "mainEntity": [
        {
          "@type": "Question",
          "name": "Психолог или врач?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сначала врач при телесных симптомах, чтобы исключить болезни. Психолог — для психологической части переживания, не для постановки диагноза."
          }
        },
        {
          "@type": "Question",
          "name": "Значит ли психосоматика, что я «придумываю»?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Ощущения реальны. Речь о связи психики и тела, а не о «симуляции»."
          }
        },
        {
          "@type": "Question",
          "name": "Поможет ли EMDR?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Метод обсуждается индивидуально, если есть связанный стрессовый или травматичный материал. Гарантий нет."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли онлайн?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, консультации доступны онлайн; очно — в Москве у метро Тургеневская / Чистые пруды и Ботанический сад."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько длится сессия?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "90 минут основная; 30 минут — бесплатная пробная."
          }
        },
        {
          "@type": "Question",
          "name": "Нужно ли бросать лечение у врача?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. Психолог не отменяет назначения врача."
          }
        },
        {
          "@type": "Question",
          "name": "Когда срочно к врачу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "При острой боли, внезапной слабости, одышке, обмороке — экстренная медицинская помощь, не статья в интернете."
          }
        }
      ]

      "mainEntity": [
        {
          "@type": "Question",
          "name": "Это синдром эмоционального выгорания?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Статья не ставит диагнозов. Если вас беспокоят симптомы, обсудите их с психологом или врачом."
          }
        },
        {
          "@type": "Question",
          "name": "Поможет ли отпуск?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Иногда да, при усталости. При выгорании одного отпуска часто недостаточно без изменения нагрузки и поддержки."
          }
        },
        {
          "@type": "Question",
          "name": "Коуч или психолог?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Коуч фокусируется на целях и действиях. Психолог — на переживаниях, тревоге, опыте, который мешает восстанавливаться. Роли могут дополнять друг друга."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько длится сессия?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "90 минут основная; 30 минут — бесплатная пробная онлайн."
          }
        },
        {
          "@type": "Question",
          "name": "EMDR при выгорании?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Обсуждается индивидуально, особенно если есть перегружающий опыт или тревога. Гарантий нет."
          }
        },
        {
          "@type": "Question",
          "name": "Конфиденциально ли?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Психологическая практика строится на конфиденциальности в рамках закона и этики. Детали — в оферте на сайте."
          }
        },
        {
          "@type": "Question",
          "name": "Можно онлайн?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, в том числе пробная встреча."
          }
        }
      ]

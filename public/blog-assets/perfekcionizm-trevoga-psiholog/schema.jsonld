    {
      "@type": "FAQPage",
      "@id": "https://www.morozovanatalia.ru/blog/perfekcionizm-trevoga-psiholog/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Перфекционизм что это такое простыми словами?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Это жесткая установка, при которой идеальный результат - единственно приемлемый. Любое отклонение от идеала воспринимается как личный провал, доказывающий собственную никчемность, и вызывает сильную тревогу."
          }
        },
        {
          "@type": "Question",
          "name": "Как связаны перфекционизм и тревога?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Напрямую. Перфекционист постоянно сканирует будущее на предмет возможных ошибок. Этот непрерывный контроль создает фоновое напряжение, истощающее нервную систему."
          }
        },
        {
          "@type": "Question",
          "name": "Почему перфекционизм приводит к прокрастинации?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Начать новое - значит рискнуть сделать неидеально. Психика защищается от потенциального стыда и критики, заставляя откладывать задачу до последнего, создавая «паралич»."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли пройти тест на перфекционизм в интернете?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, существуют опросники (Фроста, Хьюитта-Флетта). Но любой тест - это лишь ориентир для размышлений, а не клинический диагноз. Он подсвечивает проблемные зоны."
          }
        },
        {
          "@type": "Question",
          "name": "Когда точно нужно обращаться к психологу?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Когда стремление к идеалу разрушает повседневную жизнь: вы теряете сон, отказываетесь от возможностей, страх ошибки парализует действия и приводит к истощению."
          }
        },
        {
          "@type": "Question",
          "name": "Поможет ли EMDR при тревоге из-за ошибок?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, если страх связан с прошлым негативным опытом (жесткой критикой в детстве). EMDR бережно перерабатывает воспоминания, чтобы они не запускали тревогу в настоящем."
          }
        }
      ]
    }

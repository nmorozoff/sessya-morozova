# Canonical www + HTTPS (TLS на Timeweb nginx; %{HTTPS} в Apache всегда off — не использовать)
RewriteEngine On
RewriteBase /

DirectoryIndex index.php index.html

# Один 301: реальный http:// клиент (X-Forwarded-Proto: http) → https://www
RewriteCond %{HTTP:X-Forwarded-Proto} =http [NC]
RewriteRule ^ https://www.morozovanatalia.ru%{REQUEST_URI} [R=301,L]

# non-www → https://www (один шаг, со слэшем на каталогах — ниже)
RewriteCond %{HTTP_HOST} ^morozovanatalia\.ru$ [NC]
RewriteRule ^ https://www.morozovanatalia.ru%{REQUEST_URI} [R=301,L,QSA]

# amoCRM OAuth redirect URI (/amocrm/callback без каталога — иначе 301 на trailing slash)
RewriteRule ^amocrm/callback/?$ amocrm/callback.php [L]

# Trailing slash на https://www (без downgrade на http:// от mod_dir)
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/amocrm/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
RewriteRule ^(.*)$ https://www.morozovanatalia.ru/$1/ [R=301,L,QSA]

# React SPA with build-time static HTML (SSG) + client-side routing fallback
# API routes are real PHP files — never rewrite them to index.html
RewriteRule ^api/ - [L]
RewriteRule ^amocrm/ - [L]

ErrorDocument 404 /404.html

RewriteRule ^404\.html$ - [L]
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
